# VCB_BE — auth, users, gateway sang AI service
NODE_ENV=development
PORT=3011
API_PREFIX=api/v1

# Postgres (database của toàn hệ thống nằm ở BE)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vcb_video_agent?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vcb_video_agent?schema=public

# Supabase: dùng session pooler (cổng 5432) để Prisma migrate chạy được.
# Nếu dùng transaction pooler (cổng 6543) phải thêm ?pgbouncer=true&connection_limit=1
# và trỏ DIRECT_URL sang session pooler, nếu không migrate sẽ lỗi.
# Prisma tự tạo schema trong ?schema=... nên không cần CREATE SCHEMA thủ công.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?schema=aiagent

# JWT — BẮT BUỘC đổi trên production, access và refresh phải khác nhau.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Cookie: để trống thì tự suy ra từ FRONTEND_URL (https → secure + sameSite=none)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false

# AI service — secret phải trùng ASSISTANT_INTERNAL_SECRET bên VCB_AI
AI_SERVICE_URL=http://localhost:8787
AI_SERVICE_TIMEOUT_MS=120000
ASSISTANT_INTERNAL_SECRET=dev-assistant-secret-change-me
